<Window x:Class="LyricCanvas.App.Settings.SettingsWindow"
        x:Name="SettingsRoot"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="词绘"
        Width="880" Height="620"
        MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        ShowInTaskbar="True">

                    <!--
        外壳借鉴 PCL 启动器的顶部栏和左侧导航；右侧保留当前简洁的分组设置，不增加装饰性卡片。
        用 WindowChrome 把系统标题栏藏掉但保留窗口缩放和拖动能力，
        这比 AllowsTransparency 的无边框窗口轻得多（后者会强制软件渲染）。
    -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!--
            配色和控件样式由 App.xaml 作为应用级资源合并进来（SettingsTheme.xaml），
            这里不再重复合并。

            为什么不放在这里：Window 标签上的 Background 用了
            {StaticResource WindowBackgroundBrush}，而 Window.Resources 是在
            标签之后才解析的；放这里会导致解析 Background 时找不到资源、
            启动直接抛 XamlParseException（实际踩过）。
        -->
        <ResourceDictionary>
            <Style x:Key="SettingsScrollBarStyle" TargetType="{x:Type ScrollBar}">
                <Setter Property="Width" Value="8" />
                <Setter Property="Background" Value="{StaticResource ContentBackgroundBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Grid Background="{StaticResource ContentBackgroundBrush}">
                                <Track x:Name="PART_Track"
                                       Orientation="{TemplateBinding Orientation}"
                                       IsDirectionReversed="True">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageUpCommand"
                                                      Focusable="False" IsTabStop="False"
                                                      Background="Transparent" BorderThickness="0"
                                                      Opacity="0" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb MinHeight="24" Focusable="False">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border x:Name="ThumbSurface" Width="4" Margin="2,0"
                                                            CornerRadius="2"
                                                            Background="{StaticResource ControlBorderBrush}" />
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ThumbSurface" Property="Background"
                                                                    Value="{StaticResource TextDisabledBrush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsDragging" Value="True">
                                                            <Setter TargetName="ThumbSurface" Property="Background"
                                                                    Value="{StaticResource AccentBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageDownCommand"
                                                      Focusable="False" IsTabStop="False"
                                                      Background="Transparent" BorderThickness="0"
                                                      Opacity="0" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==== 标题栏 ==== -->
        <Border Grid.Row="0" Background="{StaticResource TitleBarBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="词绘" FontSize="14" Margin="8,0,0,0"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButtonStyle}"
                            Content="&#xE921;" Click="MinimizeButton_Click" ToolTip="最小化" />
                    <Button x:Name="CloseButton" Style="{StaticResource CloseButtonStyle}"
                            Content="&#xE8BB;" Click="CloseButton_Click" ToolTip="关闭窗口（程序继续在后台运行）" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==== 主体 ==== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ==== 左侧导航 ==== -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,10,0,0">
                        <RadioButton x:Name="NavLyrics" Style="{StaticResource NavButtonStyle}" Tag="&#xE8D6;"
                                     Content="歌词显示" IsChecked="True" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavWindow" Style="{StaticResource NavButtonStyle}" Tag="&#xE7C4;"
                                     Content="窗口行为" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavSource" Style="{StaticResource NavButtonStyle}" Tag="&#xE8B7;"
                                     Content="歌词来源" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavHotkey" Style="{StaticResource NavButtonStyle}" Tag="&#xE765;"
                                     Content="快捷键" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavAbout" Style="{StaticResource NavButtonStyle}" Tag="&#xE946;"
                                     Content="关于" Checked="Nav_Checked" />
                    </StackPanel>

                    <!-- 底部：状态提示，例如"设置已自动保存" -->
                    <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom"
                               Margin="16,0,16,14" TextWrapping="Wrap"
                               FontSize="11" Foreground="{StaticResource TextDisabledBrush}" />
                </DockPanel>
            </Border>

            <!-- ==== 右侧内容 ==== -->
            <ScrollViewer x:Name="SettingsContentScroll" Grid.Column="1"
                          VerticalScrollBarVisibility="Auto" Padding="20,16,20,20"
                          Loaded="SettingsContentScroll_Loaded"
                          ScrollChanged="SettingsContentScroll_ScrollChanged"
                          PreviewMouseMove="SettingsContentScroll_PreviewMouseMove">
                <ScrollViewer.Resources>
                    <Style TargetType="{x:Type ScrollBar}"
                           BasedOn="{StaticResource SettingsScrollBarStyle}" />
                </ScrollViewer.Resources>
                <Grid>
                    <!-- ==== 面板一：歌词显示 ==== -->
                    <StackPanel x:Name="PanelLyrics">

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="基础" Style="{StaticResource CardTitleStyle}" />

                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="透明度" Style="{StaticResource RowLabelStyle}" />
                                    <Slider x:Name="OpacitySlider" Grid.Column="1"
                                            Style="{StaticResource SettingSliderStyle}"
                                            Minimum="0.05" Maximum="1.0"
                                            SmallChange="0.01" LargeChange="0.1"
                                            ValueChanged="OpacitySlider_ValueChanged" />
                                    <TextBlock x:Name="OpacityValue" Grid.Column="2"
                                               Style="{StaticResource ValueTextStyle}" MinWidth="52" />
                                </Grid>

                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="字号" Style="{StaticResource RowLabelStyle}" />
                                    <Slider x:Name="FontSizeSlider" Grid.Column="1"
                                            Style="{StaticResource SettingSliderStyle}"
                                            Minimum="10" Maximum="120"
                                            SmallChange="1" LargeChange="4"
                                            ValueChanged="FontSizeSlider_ValueChanged" />
                                    <TextBlock x:Name="FontSizeValue" Grid.Column="2"
                                               Style="{StaticResource ValueTextStyle}" MinWidth="52" />
                                </Grid>

                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="字体" Style="{StaticResource RowLabelStyle}" />
                                    <ComboBox x:Name="FontFamilyCombo" Grid.Column="1"
                                              Style="{StaticResource SettingComboBoxStyle}"
                                              ItemContainerStyle="{StaticResource SettingComboBoxItemStyle}"
                                              SelectionChanged="FontFamilyCombo_SelectionChanged" />
                                    <Button Grid.Column="2" Content="导入字体" Margin="8,0,0,0"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="ImportFontButton_Click" />
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="字间距" Style="{StaticResource RowLabelStyle}" />
                                    <Slider x:Name="LetterSpacingSlider" Grid.Column="1"
                                            Style="{StaticResource SettingSliderStyle}"
                                            Minimum="-3" Maximum="20"
                                            SmallChange="1" LargeChange="4"
                                            ValueChanged="LetterSpacingSlider_ValueChanged" />
                                    <TextBlock x:Name="LetterSpacingValue" Grid.Column="2"
                                               Style="{StaticResource ValueTextStyle}" MinWidth="52" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="颜色" Style="{StaticResource CardTitleStyle}" />

                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="歌词颜色" Style="{StaticResource RowLabelStyle}" />
                                    <Border x:Name="TextColorSwatch" Grid.Column="1"
                                            Width="34" Height="26" CornerRadius="5"
                                            BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1"
                                            Cursor="Hand" MouseLeftButtonDown="TextColorSwatch_Click" />
                                    <TextBlock x:Name="TextColorValue" Grid.Column="2"
                                               Style="{StaticResource ValueTextStyle}" />
                                    <Button Grid.Column="3" Content="渐变…" Margin="8,0,0,0"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="EditTextGradient_Click" />
                                </Grid>

                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="曲名颜色" Style="{StaticResource RowLabelStyle}" />
                                    <Border x:Name="SubTextColorSwatch" Grid.Column="1"
                                            Width="34" Height="26" CornerRadius="5"
                                            BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1"
                                            Cursor="Hand" MouseLeftButtonDown="SubTextColorSwatch_Click" />
                                    <TextBlock x:Name="SubTextColorValue" Grid.Column="2"
                                               Style="{StaticResource ValueTextStyle}" />
                                </Grid>

                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="光晕范围" Style="{StaticResource RowLabelStyle}" />
                                    <Slider x:Name="GlowRadiusSlider" Grid.Column="1"
                                            Style="{StaticResource SettingSliderStyle}"
                                            Minimum="0" Maximum="48" SmallChange="1" LargeChange="4"
                                            ValueChanged="GlowRadiusSlider_ValueChanged" />
                                    <TextBlock x:Name="GlowRadiusValue" Grid.Column="2"
                                               Style="{StaticResource ValueTextStyle}" MinWidth="52" />
                                </Grid>

                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="光晕强度" Style="{StaticResource RowLabelStyle}" />
                                    <Slider x:Name="GlowOpacitySlider" Grid.Column="1"
                                            Style="{StaticResource SettingSliderStyle}"
                                            Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                                            ValueChanged="GlowOpacitySlider_ValueChanged" />
                                    <TextBlock x:Name="GlowOpacityValue" Grid.Column="2"
                                               Style="{StaticResource ValueTextStyle}" MinWidth="52" />
                                </Grid>

                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="光晕颜色" Style="{StaticResource RowLabelStyle}" />
                                    <Border x:Name="GlowColorSwatch" Grid.Column="1"
                                            Width="34" Height="26" CornerRadius="5"
                                            BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1"
                                            Cursor="Hand" MouseLeftButtonDown="GlowColorSwatch_Click" />
                                    <TextBlock x:Name="GlowColorValue" Grid.Column="2"
                                               Style="{StaticResource ValueTextStyle}" />
                                </Grid>

                                <TextBlock Text="点色块可以在预设颜色之间循环；想要任意颜色可以直接改配置文件。"
                                           TextWrapping="Wrap" FontSize="11" Margin="0,2,0,0"
                                           Foreground="{StaticResource TextDisabledBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="动态效果" Style="{StaticResource CardTitleStyle}" />
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="歌词效果" Style="{StaticResource RowLabelStyle}" />
                                    <ComboBox x:Name="LyricEffectCombo" Grid.Column="1"
                                              Style="{StaticResource SettingComboBoxStyle}"
                                              ItemContainerStyle="{StaticResource SettingComboBoxItemStyle}"
                                              SelectionChanged="LyricEffectCombo_SelectionChanged" />
                                </Grid>
                                <Grid x:Name="MotionPeriodRow" Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="运动周期" Style="{StaticResource RowLabelStyle}" />
                                    <Slider x:Name="EffectPeriodSlider" Grid.Column="1"
                                            Style="{StaticResource SettingSliderStyle}"
                                            Minimum="200" Maximum="5000" SmallChange="100" LargeChange="500"
                                            TickFrequency="100" IsSnapToTickEnabled="True"
                                            ValueChanged="EffectPeriodSlider_ValueChanged" />
                                    <TextBlock x:Name="EffectPeriodValue" Grid.Column="2"
                                               Style="{StaticResource ValueTextStyle}" MinWidth="52" />
                                </Grid>
                                <Grid x:Name="MotionIntensityRow" Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="运动幅度" Style="{StaticResource RowLabelStyle}" />
                                    <Slider x:Name="EffectIntensitySlider" Grid.Column="1"
                                            Style="{StaticResource SettingSliderStyle}"
                                            Minimum="0.1" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                                            ValueChanged="EffectIntensitySlider_ValueChanged" />
                                    <TextBlock x:Name="EffectIntensityValue" Grid.Column="2"
                                               Style="{StaticResource ValueTextStyle}" MinWidth="52" />
                                </Grid>
                                <StackPanel x:Name="ParticleSettingsPanel" Visibility="Collapsed" Margin="0,8,0,0">
                                    <TextBlock Text="粒子设置" Style="{StaticResource CardTitleStyle}" />
                                    <Grid Style="{StaticResource SettingRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="粒子大小" Style="{StaticResource RowLabelStyle}" />
                                        <Slider x:Name="ParticleSizeSlider" Grid.Column="1"
                                                Style="{StaticResource SettingSliderStyle}"
                                                Minimum="2" Maximum="18" SmallChange="1" LargeChange="2"
                                                TickFrequency="1" IsSnapToTickEnabled="True"
                                                ValueChanged="ParticleSizeSlider_ValueChanged" />
                                        <TextBlock x:Name="ParticleSizeValue" Grid.Column="2"
                                                   Style="{StaticResource ValueTextStyle}" MinWidth="52" />
                                    </Grid>
                                    <Grid Style="{StaticResource SettingRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="粒子数量" Style="{StaticResource RowLabelStyle}" />
                                        <Slider x:Name="ParticleCountSlider" Grid.Column="1"
                                                Style="{StaticResource SettingSliderStyle}"
                                                Minimum="4" Maximum="32" SmallChange="1" LargeChange="4"
                                                TickFrequency="1" IsSnapToTickEnabled="True"
                                                ValueChanged="ParticleCountSlider_ValueChanged" />
                                        <TextBlock x:Name="ParticleCountValue" Grid.Column="2"
                                                   Style="{StaticResource ValueTextStyle}" MinWidth="52" />
                                    </Grid>
                                    <Grid Style="{StaticResource SettingRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="散开距离" Style="{StaticResource RowLabelStyle}" />
                                        <Slider x:Name="ParticleSpreadSlider" Grid.Column="1"
                                                Style="{StaticResource SettingSliderStyle}"
                                                Minimum="12" Maximum="220" SmallChange="4" LargeChange="20"
                                                TickFrequency="4" IsSnapToTickEnabled="True"
                                                ValueChanged="ParticleSpreadSlider_ValueChanged" />
                                        <TextBlock x:Name="ParticleSpreadValue" Grid.Column="2"
                                                   Style="{StaticResource ValueTextStyle}" MinWidth="52" />
                                    </Grid>
                                    <Grid Style="{StaticResource SettingRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="单次时长" Style="{StaticResource RowLabelStyle}" />
                                        <Slider x:Name="ParticleDurationSlider" Grid.Column="1"
                                                Style="{StaticResource SettingSliderStyle}"
                                                Minimum="300" Maximum="5000" SmallChange="100" LargeChange="500"
                                                TickFrequency="100" IsSnapToTickEnabled="True"
                                                ValueChanged="ParticleDurationSlider_ValueChanged" />
                                        <TextBlock x:Name="ParticleDurationValue" Grid.Column="2"
                                                   Style="{StaticResource ValueTextStyle}" MinWidth="52" />
                                    </Grid>
                                    <TextBlock Text="每句新歌词出现时散开一轮；粒子由文字周围向外移动并淡出。"
                                               TextWrapping="Wrap" FontSize="11" Margin="0,2,0,0"
                                               Foreground="{StaticResource TextDisabledBrush}" />
                                </StackPanel>
                                <TextBlock Text="上下/左右运动的周期表示完成一次往返的时间；粒子参数仅在选择粒子散开时显示。"
                                           TextWrapping="Wrap" FontSize="11" Margin="0,2,0,0"
                                           Foreground="{StaticResource TextDisabledBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="播放效果" Style="{StaticResource CardTitleStyle}" />
                                <CheckBox x:Name="PlaybackFadeCheck"
                                          Style="{StaticResource SettingCheckBoxStyle}"
                                          Content="淡入淡出"
                                          Checked="PlaybackEffectCheck_Changed"
                                          Unchecked="PlaybackEffectCheck_Changed" />
                                <StackPanel x:Name="FadePlaybackOptions" Margin="18,4,0,0">
                                    <Grid Style="{StaticResource SettingRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="淡入时长" Style="{StaticResource RowLabelStyle}" />
                                        <Slider x:Name="FadeInSlider" Grid.Column="1"
                                                Style="{StaticResource SettingSliderStyle}"
                                                Minimum="0" Maximum="3000"
                                                SmallChange="10" LargeChange="100"
                                                ValueChanged="FadeInSlider_ValueChanged" />
                                        <TextBlock x:Name="FadeInValue" Grid.Column="2"
                                                   Style="{StaticResource ValueTextStyle}" MinWidth="64" />
                                    </Grid>
                                    <Grid Style="{StaticResource SettingRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="淡出时长" Style="{StaticResource RowLabelStyle}" />
                                        <Slider x:Name="FadeOutSlider" Grid.Column="1"
                                                Style="{StaticResource SettingSliderStyle}"
                                                Minimum="0" Maximum="3000"
                                                SmallChange="10" LargeChange="100"
                                                ValueChanged="FadeOutSlider_ValueChanged" />
                                        <TextBlock x:Name="FadeOutValue" Grid.Column="2"
                                                   Style="{StaticResource ValueTextStyle}" MinWidth="64" />
                                    </Grid>
                                    <Grid Style="{StaticResource SettingRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="停留时长" Style="{StaticResource RowLabelStyle}" />
                                        <Slider x:Name="HoldDurationSlider" Grid.Column="1"
                                                Style="{StaticResource SettingSliderStyle}"
                                                Minimum="0" Maximum="5000"
                                                SmallChange="50" LargeChange="500"
                                                ValueChanged="HoldDurationSlider_ValueChanged" />
                                        <TextBlock x:Name="HoldDurationValue" Grid.Column="2"
                                                   Style="{StaticResource ValueTextStyle}" MinWidth="64" />
                                    </Grid>
                                    <CheckBox x:Name="HoldUntilNextFrameLineCheck"
                                              Style="{StaticResource SettingCheckBoxStyle}"
                                              Content="同一歌词框保留到它的下一句再淡出"
                                              Margin="0,8,0,4"
                                              Checked="HoldUntilNextFrameLineCheck_Click"
                                              Unchecked="HoldUntilNextFrameLineCheck_Click" />
                                    <TextBlock Text="停留时长从淡入完成后计时，0 表示不限制；本框下一句到来时也会触发淡出，两个条件以先到者为准。"
                                               TextWrapping="Wrap" FontSize="11" Margin="0,2,0,0"
                                               Foreground="{StaticResource TextDisabledBrush}" />
                                </StackPanel>

                                <CheckBox x:Name="PlaybackSweepCheck"
                                          Style="{StaticResource SettingCheckBoxStyle}"
                                          Content="从左至右"
                                          Margin="0,10,0,0"
                                          Checked="PlaybackEffectCheck_Changed"
                                          Unchecked="PlaybackEffectCheck_Changed" />
                                <StackPanel x:Name="SweepPlaybackOptions" Margin="18,4,0,0">
                                    <TextBlock Text="增强 LRC 使用逐词时间戳；普通 LRC 会按整句时间估算推进。此效果会关闭淡入淡出。"
                                               TextWrapping="Wrap" FontSize="11" Margin="0,0,0,6"
                                               Foreground="{StaticResource TextDisabledBrush}" />
                                    <Grid Style="{StaticResource SettingRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="未播放" Style="{StaticResource RowLabelStyle}" />
                                        <CheckBox x:Name="UnplayedColorCustomCheck" Grid.Column="1"
                                                  Style="{StaticResource SettingCheckBoxStyle}"
                                                  Content="自定义"
                                                  Checked="PlaybackColorCustomCheck_Changed"
                                                  Unchecked="PlaybackColorCustomCheck_Changed" />
                                        <Border x:Name="UnplayedColorSwatch" Grid.Column="2" Margin="8,0,0,0"
                                                Width="34" Height="26" CornerRadius="5"
                                                BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1"
                                                Cursor="Hand" MouseLeftButtonDown="PlaybackColorSwatch_Click" />
                                        <TextBlock x:Name="UnplayedColorValue" Grid.Column="3" Margin="8,0,0,0"
                                                   Style="{StaticResource ValueTextStyle}" VerticalAlignment="Center" />
                                    </Grid>
                                    <Grid Style="{StaticResource SettingRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="已播放" Style="{StaticResource RowLabelStyle}" />
                                        <CheckBox x:Name="PlayedColorCustomCheck" Grid.Column="1"
                                                  Style="{StaticResource SettingCheckBoxStyle}"
                                                  Content="自定义"
                                                  Checked="PlaybackColorCustomCheck_Changed"
                                                  Unchecked="PlaybackColorCustomCheck_Changed" />
                                        <Border x:Name="PlayedColorSwatch" Grid.Column="2" Margin="8,0,0,0"
                                                Width="34" Height="26" CornerRadius="5"
                                                BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1"
                                                Cursor="Hand" MouseLeftButtonDown="PlaybackColorSwatch_Click" />
                                        <TextBlock x:Name="PlayedColorValue" Grid.Column="3" Margin="8,0,0,0"
                                                   Style="{StaticResource ValueTextStyle}" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="显示内容" Style="{StaticResource CardTitleStyle}" />

                                <TextBlock Text="这个窗口本质上是个桌面文字叠加层，显示什么由你决定。"
                                           TextWrapping="Wrap" FontSize="11" Margin="0,0,0,12"
                                           Foreground="{StaticResource TextDisabledBrush}" />

                                <RadioButton x:Name="ModeLyricsRadio" GroupName="ContentMode"
                                             Content="显示当前播放歌曲的歌词"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             FontSize="13" Margin="0,0,0,10" IsChecked="True"
                                             Checked="ContentMode_Checked" />

                                <RadioButton x:Name="ModeCustomTextRadio" GroupName="ContentMode"
                                             Content="显示我自己输入的文字"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             FontSize="13" Margin="0,0,0,10"
                                             Checked="ContentMode_Checked" />

                                <TextBox x:Name="CustomTextBox"
                                         Style="{StaticResource SettingTextBoxStyle}"
                                         Height="64" AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalContentAlignment="Top" Padding="10,6"
                                         TextChanged="CustomTextBox_TextChanged" />

                                <TextBlock Text="可以写多行。文字超出一行的宽度时会截断显示省略号；想让它滚动显示是以后的功能。"
                                           TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"
                                           Foreground="{StaticResource TextDisabledBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="歌词行" Style="{StaticResource CardTitleStyle}" />

                                <CheckBox x:Name="ShowTrackInfoCheck" Style="{StaticResource SettingCheckBoxStyle}"
                                          Content="显示曲名和歌手（关掉就只显示歌词一行）"
                                          Margin="0,0,0,10" Click="ShowTrackInfoCheck_Click" Checked="ShowTrackInfoCheck_Click" Unchecked="ShowTrackInfoCheck_Click" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock x:Name="LyricsSettingsStatus"
                                               Text="歌词显示设置已保存。"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="歌词框会随草稿实时预览；确认并保存会保留修改，取消会恢复修改前的设置。"
                                               TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"
                                               Foreground="{StaticResource TextDisabledBrush}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="取消修改"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="0,0,8,0" Click="CancelLyricsSettings_Click" />
                                <Button Grid.Column="2" Content="确认并保存"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="ConfirmLyricsSettings_Click" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ==== 面板二：窗口行为 ==== -->
                    <StackPanel x:Name="PanelWindow" Visibility="Collapsed">

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="位置与层级" Style="{StaticResource CardTitleStyle}" />

                                <CheckBox x:Name="TopmostCheck" Style="{StaticResource SettingCheckBoxStyle}"
                                          Content="始终显示在其他窗口之上"
                                          Margin="0,0,0,12" Click="TopmostCheck_Click" Checked="TopmostCheck_Click" Unchecked="TopmostCheck_Click" />

                                <Button x:Name="OpenLayoutEditorButton" Content="调整歌词布局…"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="OpenLayoutEditor_Click" />

                                <TextBlock Text="打开全屏的布局编辑器，拖动方框调整每个歌词框的位置和大小。也可以按快捷键或从托盘菜单进入。"
                                           TextWrapping="Wrap" FontSize="11" Margin="0,10,0,0"
                                           Foreground="{StaticResource TextDisabledBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="鼠标交互" Style="{StaticResource CardTitleStyle}" />

                                <CheckBox x:Name="LockedCheck" Style="{StaticResource SettingCheckBoxStyle}"
                                          Content="锁定窗口（鼠标穿透，点不动也拖不动）"
                                          Margin="0,0,0,10" Click="LockedCheck_Click" Checked="LockedCheck_Click" Unchecked="LockedCheck_Click" />

                                <TextBlock x:Name="LockHintText" TextWrapping="Wrap" FontSize="11"
                                           Foreground="{StaticResource TextDisabledBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ==== 面板三：歌词来源 ==== -->
                    <StackPanel x:Name="PanelSource" Visibility="Collapsed">

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="自动获取歌词" Style="{StaticResource CardTitleStyle}" />

                                <CheckBox x:Name="FetchNetworkCheck" Style="{StaticResource SettingCheckBoxStyle}"
                                          Content="本地找不到时，联网自动抓取歌词"
                                          Margin="0,0,0,10"
                                          Click="FetchNetworkCheck_Click" Checked="FetchNetworkCheck_Click" Unchecked="FetchNetworkCheck_Click" />

                                <TextBlock TextWrapping="Wrap" FontSize="11"
                                           Foreground="{StaticResource TextDisabledBrush}"
                                           Text="抓取顺序：先读你自己放在歌词目录里的文件，再读缓存；都没有才联网。抓到的歌词会存进缓存，下次放同一首歌就不再联网。不需要联网可以关掉这项，程序就只认本地文件。" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="播放器识别与同步诊断" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock x:Name="MediaSourceDiagnosticsText" Text="正在读取媒体会话…"
                                           TextWrapping="Wrap" FontSize="11" Margin="0,0,0,10"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <Button Content="重新查找当前歌曲" Style="{StaticResource SecondaryButtonStyle}"
                                        HorizontalAlignment="Left" Margin="0,0,0,10"
                                        Click="RefreshCurrentLyrics_Click" />
                                <TextBlock x:Name="CurrentLyricsResolutionText" Text="当前歌曲歌词尚未就绪。"
                                           TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Button x:Name="ConfirmLyricsMatchButton" Content="确认当前匹配"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            IsEnabled="False" Click="ConfirmLyricsMatch_Click" />
                                    <Button x:Name="RejectLyricsMatchButton" Content="不是这首，尝试其他结果"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="8,0,0,0" IsEnabled="False"
                                            Click="RejectLyricsMatch_Click" />
                                </StackPanel>
                                <TextBlock Text="允许的其他播放器 App ID（每行一个）" Style="{StaticResource RowLabelStyle}"
                                           Margin="0,0,0,6" />
                                <TextBox x:Name="MediaAppAllowListBox"
                                         Style="{StaticResource SettingTextBoxStyle}"
                                         MinHeight="64" MaxHeight="100"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         TextChanged="MediaAppAllowListBox_TextChanged" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button x:Name="CopyObservedMediaAppIdButton" Content="复制当前发现的 App ID"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="CopyObservedMediaAppIdButton_Click" />
                                </StackPanel>
                                <TextBlock Text="默认只选已识别的音乐播放器，视频软件和浏览器会话会被忽略。未知播放器可从诊断信息复制 App ID 后粘贴到这里；改动会自动保存。"
                                           TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"
                                           Foreground="{StaticResource TextDisabledBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="逐首歌曲歌词微调" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock Text="按当前歌曲保存时间偏移，离线导入的 LRC 也会应用。正值让歌词提前，负值让歌词延后；每次调整 100 毫秒。"
                                           TextWrapping="Wrap" FontSize="11" Margin="0,0,0,10"
                                           Foreground="{StaticResource TextDisabledBrush}" />
                                <TextBlock x:Name="CurrentLyricTrackText" Text="尚未读取到播放器歌曲信息"
                                           TextWrapping="Wrap" FontSize="12"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock x:Name="CurrentLyricOffsetText" Text="当前偏移：0 毫秒"
                                           Margin="0,5,0,10" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="EarlierLyricButton" Content="歌词提前 100 毫秒"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="EarlierLyricButton_Click" />
                                    <Button x:Name="LaterLyricButton" Content="歌词延后 100 毫秒"
                                            Margin="8,0,0,0" Style="{StaticResource SecondaryButtonStyle}"
                                            Click="LaterLyricButton_Click" />
                                    <Button x:Name="ClearLyricOffsetButton" Content="清除本曲偏移"
                                            Margin="8,0,0,0" Style="{StaticResource SecondaryButtonStyle}"
                                            Click="ClearLyricOffsetButton_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="实时歌词校准（实验）" Style="{StaticResource CardTitleStyle}" />

                                <CheckBox x:Name="AudioLyricSyncCheck" Style="{StaticResource SettingCheckBoxStyle}"
                                          Content="用本地识别的歌声校准歌词进度"
                                          Margin="0,0,0,8"
                                          Checked="AudioLyricSyncCheck_Click"
                                          Unchecked="AudioLyricSyncCheck_Click" />

                                <TextBlock x:Name="AudioLyricSyncStatusText" Text="未启用"
                                           TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="歌词缓存" Style="{StaticResource CardTitleStyle}" />

                                <TextBlock x:Name="CacheInfoText" TextWrapping="Wrap" FontSize="12"
                                           Margin="0,0,0,12"
                                           Foreground="{StaticResource TextSecondaryBrush}" />

                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="ClearCacheButton" Content="清空缓存"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="ClearCache_Click" />
                                    <Button Content="打开缓存目录" Margin="8,0,0,0"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="OpenCacheDirectory_Click" />
                                    <Button Content="刷新" Margin="8,0,0,0"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="RefreshCacheInfo_Click" />
                                </StackPanel>

                                <TextBlock Text="清理只处理 cache 目录顶层中可确认由词绘管理的缓存歌词；未知文件、子目录和重解析点会保留。歌词目录根部的个人 LRC 不受影响。"
                                           TextWrapping="Wrap" FontSize="11" Margin="0,10,0,0"
                                           Foreground="{StaticResource TextDisabledBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="歌词文件目录" Style="{StaticResource CardTitleStyle}" />

                                <TextBlock Text="程序会在这个目录里按曲名找 .lrc 文件，例如《起风了》就找 起风了.lrc。"
                                           TextWrapping="Wrap" FontSize="12" Margin="0,0,0,12"
                                           Foreground="{StaticResource TextSecondaryBrush}" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="LyricsDirectoryBox" Grid.Column="0"
                                             Style="{StaticResource SettingTextBoxStyle}"
                                             TextChanged="LyricsDirectoryBox_TextChanged" />
                                    <Button Grid.Column="1" Content="打开目录" Margin="8,0,0,0"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="OpenLyricsDirectory_Click" />
                                </Grid>

                                <TextBlock x:Name="LyricsDirectoryHint" TextWrapping="Wrap" FontSize="11"
                                           Margin="0,10,0,0" Foreground="{StaticResource TextDisabledBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="实际搜索顺序" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock x:Name="SearchOrderText" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ==== 面板四：关于 ==== -->
                    <!-- ==== 面板四：快捷键与后台 ==== -->
                    <StackPanel x:Name="PanelHotkey" Visibility="Collapsed">

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="全局快捷键" Style="{StaticResource CardTitleStyle}" />

                                <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="歌词框默认是鼠标穿透的、点不到，所以快捷键是打开布局编辑器最可靠的入口。" />

                                <CheckBox x:Name="HotkeyEnabledCheck" Style="{StaticResource SettingCheckBoxStyle}"
                                          Content="启用全局快捷键"
                                          Margin="0,0,0,12"
                                          Click="HotkeyEnabledCheck_Click" Checked="HotkeyEnabledCheck_Click" Unchecked="HotkeyEnabledCheck_Click" />

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="打开布局编辑器" Style="{StaticResource RowLabelStyle}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <CheckBox x:Name="HotkeyCtrlCheck" Style="{StaticResource SettingCheckBoxStyle}"
                                                  Content="Ctrl" Margin="0,0,16,0"
                                                  Click="HotkeyModifier_Click" Checked="HotkeyModifier_Click" Unchecked="HotkeyModifier_Click" />
                                        <CheckBox x:Name="HotkeyAltCheck" Style="{StaticResource SettingCheckBoxStyle}"
                                                  Content="Alt" Margin="0,0,16,0"
                                                  Click="HotkeyModifier_Click" Checked="HotkeyModifier_Click" Unchecked="HotkeyModifier_Click" />
                                        <CheckBox x:Name="HotkeyShiftCheck" Style="{StaticResource SettingCheckBoxStyle}"
                                                  Content="Shift" Margin="0,0,16,0"
                                                  Click="HotkeyModifier_Click" Checked="HotkeyModifier_Click" Unchecked="HotkeyModifier_Click" />
                                        <ComboBox x:Name="HotkeyKeyCombo" Width="110"
                                                  Style="{StaticResource SettingComboBoxStyle}"
                                                  ItemContainerStyle="{StaticResource SettingComboBoxItemStyle}"
                                                  SelectionChanged="HotkeyKeyCombo_SelectionChanged" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock x:Name="HotkeyHintText" TextWrapping="Wrap" FontSize="11"
                                           Foreground="{StaticResource TextDisabledBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="后台运行" Style="{StaticResource CardTitleStyle}" />

                                <CheckBox x:Name="RunInBackgroundCheck" Style="{StaticResource SettingCheckBoxStyle}"
                                          Content="关闭窗口后继续在后台运行（托盘里保留图标）"
                                          Click="RunInBackgroundCheck_Click" Checked="RunInBackgroundCheck_Click" Unchecked="RunInBackgroundCheck_Click" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ==== 面板五：关于 ==== -->
                    <StackPanel x:Name="PanelAbout" Visibility="Collapsed">
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="词绘（LyricCanvas）" FontSize="20" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock x:Name="VersionText" Margin="0,6,0,0" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" />

                                <TextBlock Margin="0,16,0,0" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="在桌面上显示系统正在播放的音乐歌词，也可以当通用的桌面文字叠加层用。曲名歌手通过 Windows 的系统媒体控制（SMTC）读取；歌词优先用你自己的 .lrc 文件，找不到就联网获取并缓存。" />

                                <TextBlock Margin="0,16,0,0" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="配置文件位置：" />
                                <TextBox x:Name="ConfigPathBox" Margin="0,6,0,0" IsReadOnly="True"
                                         Style="{StaticResource SettingTextBoxStyle}"
                                         Background="#FF26262A" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="打开配置目录" Style="{StaticResource SecondaryButtonStyle}"
                                            Click="OpenConfigDirectory_Click" />
                                    <Button Content="刷新设置" Margin="8,0,0,0"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="ReloadConfig_Click" />
                                </StackPanel>

                                <TextBlock Margin="0,16,0,0" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="快捷键说明：" />
                                <TextBlock x:Name="AboutFeaturesText" Margin="0,6,0,0" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" />

                                <TextBlock Margin="0,16,0,0" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="许可证：MIT" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
